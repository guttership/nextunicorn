// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Idea {
  id          Int     @id @default(autoincrement())
  title       String
  slogan      String
  description String
  aiPrompt    String
  generatedAt DateTime @default(now())
  isChampion  Boolean @default(false)
  createdAt   DateTime @default(now())
  score       Int     @default(0)
  isDaily     Boolean @default(true)
  aiPromptId  String

  votesAsWinner Vote[] @relation("WinnerIdea")
  votesAsLoser  Vote[] @relation("LoserIdea")
  translations  IdeaTranslation[]

  @@index([score])
  @@index([createdAt])
  @@index([generatedAt])
}

model IdeaTranslation {
  id          Int    @id @default(autoincrement())
  ideaId      Int
  language    String // 'fr', 'de', 'es'
  slogan      String
  description String
  
  idea        Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  
  @@unique([ideaId, language])
}

model Vote {
  id            Int     @id @default(autoincrement())
  voterId       String
  winnerIdeaId  Int
  loserIdeaId   Int
  duelId        String
  createdAt     DateTime @default(now())

  winnerIdea    Idea    @relation("WinnerIdea", fields: [winnerIdeaId], references: [id], onDelete: Cascade)
  loserIdea     Idea    @relation("LoserIdea", fields: [loserIdeaId], references: [id], onDelete: Cascade)

  @@unique([voterId, duelId])
  @@index([voterId])
  @@index([duelId])
  @@index([createdAt])
}

model AdSlot {
  id              Int         @id @default(autoincrement())
  position        Int         // 1, 2, 3, etc. (ordre des cards)
  side            String      // 'recto' ou 'verso'
  price           Float       // Prix de cet emplacement
  expiresAt       DateTime
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  
  advertisers     Advertiser[]

  @@unique([position, side])
  @@index([isActive])
  @@index([expiresAt])
}

model Advertiser {
  id              Int       @id @default(autoincrement())
  saasName        String
  logoUrl         String
  targetUrl       String
  customerEmail   String
  stripeSessionId String    @unique
  clicks          Int       @default(0)
  isApproved      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  
  adSlotId        Int
  adSlot          AdSlot    @relation(fields: [adSlotId], references: [id], onDelete: Cascade)

  @@index([adSlotId])
  @@index([isApproved])
}
