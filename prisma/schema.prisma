generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Idea {
  id               Int               @id @default(autoincrement())
  title            String
  slogan           String
  description      String
  aiPrompt         String
  generatedAt      DateTime          @default(now())
  isChampion       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  score            Int               @default(0)
  isDaily          Boolean           @default(true)
  aiPromptId       String
  isReserved       Boolean           @default(false)
  reservedAt       DateTime?
  reservedBy       String?
  reservationPrice Float?            @default(19.0)
  origin           Origin            @default(AI)
  isCommunityValidated Boolean       @default(false)
  communityValidatedAt DateTime?
  audience         String?
  translations     IdeaTranslation[]
  votesAsLoser     Vote[]            @relation("LoserIdea")
  votesAsWinner    Vote[]            @relation("WinnerIdea")

  @@index([score])
  @@index([createdAt])
  @@index([generatedAt])
  @@index([isReserved])
}

enum Origin {
  AI
  COMMUNITY
}

model IdeaTranslation {
  id          Int    @id @default(autoincrement())
  ideaId      Int
  language    String
  slogan      String
  description String
  title       String
  aiPrompt    String
  idea        Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@unique([ideaId, language])
}

model Vote {
  id           Int      @id @default(autoincrement())
  voterId      String
  winnerIdeaId Int
  loserIdeaId  Int
  duelId       String
  createdAt    DateTime @default(now())
  loserIdea    Idea     @relation("LoserIdea", fields: [loserIdeaId], references: [id], onDelete: Cascade)
  winnerIdea   Idea     @relation("WinnerIdea", fields: [winnerIdeaId], references: [id], onDelete: Cascade)

  @@unique([voterId, duelId])
  @@index([voterId])
  @@index([duelId])
  @@index([createdAt])
}

model AdSlot {
  id          Int          @id @default(autoincrement())
  position    Int
  side        String
  price       Float
  expiresAt   DateTime
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  advertisers Advertiser[]

  @@unique([position, side])
  @@index([isActive])
  @@index([expiresAt])
}

model Advertiser {
  id              Int      @id @default(autoincrement())
  saasName        String
  logoUrl         String
  targetUrl       String
  customerEmail   String
  stripeSessionId String   @unique
  clicks          Int      @default(0)
  isApproved      Boolean  @default(false)
  createdAt       DateTime @default(now())
  adSlotId        Int
  adSlot          AdSlot   @relation(fields: [adSlotId], references: [id], onDelete: Cascade)

  @@index([adSlotId])
  @@index([isApproved])
}
