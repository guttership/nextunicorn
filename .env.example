# Database (local SQLite for dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# OpenAI API
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-5-mini"

# PostHog (EU)
NEXT_PUBLIC_POSTHOG_TOKEN="phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Backward-compatible alias (optional)
NEXT_PUBLIC_POSTHOG_KEY=""
# Leave empty to use the built-in reverse proxy via /ingest
NEXT_PUBLIC_POSTHOG_HOST=""

# Stripe (Production)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# App URL (for metadata and redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-only admin/API secrets
ADMIN_PASSWORD="replace_with_a_long_random_admin_password"
CRON_SECRET="replace_with_a_long_random_cron_secret"

# Optional: Stripe Test Keys (Development)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
